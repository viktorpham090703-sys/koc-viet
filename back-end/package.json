{
  "name": "nexrall-koc-viet-back-end",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/database/d1-adapter.test.ts src/modules/core/seed.test.ts src/modules/core/data/kol-profiles.test.ts src/modules/core/lib/jwt.test.ts src/modules/core/lib/bankDestination.test.ts src/modules/core/lib/payosPayout.test.ts src/modules/core/lib/smtp.test.ts",
    "db:import": "psql -v ON_ERROR_STOP=1 -f ../database/postgresql_full.sql",
    "push:keys": "web-push generate-vapid-keys",
    "secret:generate": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "compression": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "pg": "latest",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/compression": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/web-push": "^3.6.4",
    "tsx": "latest",
    "typescript": "latest"
  }
}
