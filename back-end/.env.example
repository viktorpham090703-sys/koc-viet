PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/koc-viet
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-bytes-before-production
AWS_REGION=ap-southeast-1
AWS_S3_IDENTITY_BUCKET=
# Optional for S3-compatible storage or local testing; leave empty on AWS S3.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Existing integrations (copy values from the old deployment when used)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Web Push (generate once with: npm run push:keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@kocviet.com

# Social OAuth2 Follower Verification (YouTube, TikTok, Meta)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
