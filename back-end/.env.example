PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/koc-viet
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-bytes-before-production
AWS_REGION=ap-southeast-1
AWS_S3_IDENTITY_BUCKET=
# Optional for S3-compatible storage or local testing; leave empty on AWS S3.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Existing integrations (copy values from the old deployment when used)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# VNPAY Gateway (Sandbox / Production)
VNPAY_TMN_CODE=KOCVTES1
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/business.html
# Brevo transactional email (sender must be verified in Brevo)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=kocviet@netviettv.com.vn
EMAIL_FROM_NAME=KOC Việt

# Web Push (generate once with: npm run push:keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@kocviet.com

# Social OAuth2 Follower Verification (YouTube, TikTok, Meta)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
